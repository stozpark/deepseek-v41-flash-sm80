+# SM80 backport compatibility: shared balanced TP row partition.
+def balanced_row_counts(num_rows: int, size: int) -> list[int]:
+    """Per-rank row counts using base + (rank < remainder)."""
+    base, rem = divmod(num_rows, size)
+    return [base + (rank < rem) for rank in range(size)]
+
+
+def balanced_row_bounds(
+    start: int, stop: int, rank: int, size: int
+) -> tuple[int, int]:
+    """This rank's contiguous half-open balanced range in [start, stop)."""
+    base, rem = divmod(stop - start, size)
+    lo = start + rank * base + min(rank, rem)
+    return lo, lo + base + (rank < rem)
