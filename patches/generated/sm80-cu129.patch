+        if PAD_IS_UINT8:
+            pad_vals = tl.full([BLOCK_T, BLOCK_D], PAD_VALUE, tl.uint8)
+        else:
+            pad_vals = tl.full([BLOCK_T, BLOCK_D], PAD_VALUE, tl.float32)
+        tl.store(out_row_ptr, pad_vals, mask=t_mask[:, None] & d_mask)
+
