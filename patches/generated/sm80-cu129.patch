+            **compile_key_fields,
+            dtype=dtype,
+            pad_value=int(pad_value) if is_uint8 else float(pad_value),
+            pad_is_uint8=is_uint8,
+        )
+
+    def get_warmup_keys(
+        self,
+        *,
+        dtype: torch.dtype,
