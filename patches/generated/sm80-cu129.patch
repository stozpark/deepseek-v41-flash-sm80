+        in_row = in_start + off_t
+        valid_row = (off_t < seq_len) & t_mask
+
+        # Pointers
+        # x_ptr: row-major [N, D]
+        x_row_ptr = x_ptr + in_row[:, None] * D + off_d[None, :]
+
+        # out_ptr: row-major [B, Lmax, D]
+        out_row_ptr = out_ptr + (pid_b * Lmax + off_t)[:, None] * D + off_d[None, :]
+
