+        WINDOW_SIZE=window_size,
+        BLOCK_M=block_m,
+        BLOCK_H=block_h,
+        BLOCK_D=block_d,
+        BLOCK_K=block_k,
+        num_warps=_prefill_blocked_num_warps(block_m),
+    )
