+            pad_value=pad_value,
+            block_t=64,
+            block_d=64,
+        )
+
+    def warmup_inputs(self, compile_key: CompileKey) -> dict[str, Any]:
+        return dict(
+            x_reshaped=TritonWarmupTensor(compile_key.dtype),
+            out=TritonWarmupTensor(compile_key.dtype),
+            lengths=TritonWarmupTensor(torch.int32),
+            N=1,
