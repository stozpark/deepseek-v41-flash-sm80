Bootstrap: docker
From: vllm/vllm-openai:deepseekv41-flash-0909

%labels
    Maintainer stozpark
    Model deepseek-ai/DeepSeek-V4.1-Flash
    GPU NVIDIA-A100-SM80
    BaseImage vllm/vllm-openai:deepseekv41-flash-0909
    CUDA 13.0.1
    SM80BackportCommit 24cb31bb4fd0becee65c810c913a8caa4f610c36
    SM80PatchScope production-minimal-25-files

%files
    patches/generated/sm80-cu130-minimal.patch /opt/sm80-patch/sm80-cu130-minimal.patch
    patches/generated/sm80-cu130-minimal.patch.sha256 /opt/sm80-patch/sm80-cu130-minimal.patch.sha256
    patches/generated/sm80-cu130-minimal.manifest.txt /opt/sm80-patch/sm80-cu130-minimal.manifest.txt
    patches/apply_minimal_patch.py /opt/sm80-patch/apply_minimal_patch.py

%environment
    export PYTHONUNBUFFERED=1
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export TOKENIZERS_PARALLELISM=false
    export NCCL_ALGO=Ring
    export NCCL_PROTO=Simple

%post
    set -eu
    python3 /opt/sm80-patch/apply_minimal_patch.py
    python3 - <<'PY'
import importlib.metadata as m
import pathlib
import torch
import vllm

print("vllm", m.version("vllm"))
print("torch", torch.__version__)
print("torch.version.cuda", torch.version.cuda)
try:
    print("triton", m.version("triton"))
except Exception as exc:
    print("triton unknown", exc)

cuda = str(torch.version.cuda or "")
if not cuda.startswith("13.0"):
    raise SystemExit(f"ERROR: main/cu130 build requires CUDA 13.0 PyTorch runtime, got {cuda!r}")

root = pathlib.Path(vllm.__file__).resolve().parent
for rel in (
    "v1/attention/ops/fp8_sm80.py",
    "v1/attention/ops/mqa_logits_triton.py",
    "models/deepseek_v4_1/ampere/ampere_sparse.py",
    "models/deepseek_v4_1/nvidia/model.py",
    "models/deepseek_v4_1/common/engram.py",
):
    assert (root / rel).is_file(), rel
print("SM80 production-minimal patch static verification: OK")
print("CUDA 13.0 runtime verification: OK")
PY

%runscript
    exec "$@"
