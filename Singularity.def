Bootstrap: docker
From: vllm/vllm-openai:deepseekv41-flash-0909

%labels
    Maintainer stozpark
    Model deepseek-ai/DeepSeek-V4.1-Flash
    GPU NVIDIA-A100-SM80
    BaseImage vllm/vllm-openai:deepseekv41-flash-0909
    CUDA 13.0.1
    SM80OverlayCommit 24cb31bb4fd0becee65c810c913a8caa4f610c36

%files
    patches/vendor/vllm /opt/sm80-overlay/vllm
    patches/vendor/BACKPORT_COMMIT /opt/sm80-overlay/BACKPORT_COMMIT
    patches/vendor/SHA256SUMS /opt/sm80-overlay/SHA256SUMS
    patches/apply_overlay.py /opt/sm80-overlay/apply_overlay.py

%environment
    export PYTHONUNBUFFERED=1
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export TOKENIZERS_PARALLELISM=false
    export NCCL_ALGO=Ring
    export NCCL_PROTO=Simple

%post
    set -eu
    python3 /opt/sm80-overlay/apply_overlay.py
    python3 - <<'PY'
import importlib.metadata as m
import pathlib
import vllm
print("vllm", m.version("vllm"))
for p in ("torch", "triton"):
    try:
        print(p, m.version(p))
    except Exception as exc:
        print(p, "unknown", exc)
root = pathlib.Path(vllm.__file__).resolve().parent
assert (root / "v1/attention/ops/fp8_sm80.py").exists()
assert (root / "models/deepseek_v4_1/ampere/ampere_sparse.py").exists()
print("SM80 vendored overlay static verification: OK")
PY

%runscript
    exec "$@"
