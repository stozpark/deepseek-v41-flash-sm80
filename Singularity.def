# Optional definition-file form. The local Docker image must exist first:
#   ./build_docker_cu129.sh
# Then:
#   apptainer build deepseek-v41-flash-sm80-cu129.sif Singularity.def
Bootstrap: docker-daemon
From: deepseek-v41-flash-sm80:cu129

%labels
    Maintainer stozpark
    Model deepseek-ai/DeepSeek-V4.1-Flash
    GPU NVIDIA-A100-SM80
    CUDA 12.9.1
    BackportCommit 24cb31bb4fd0becee65c810c913a8caa4f610c36

%environment
    export PYTHONUNBUFFERED=1
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export TOKENIZERS_PARALLELISM=false
    export NCCL_ALGO=Ring
    export NCCL_PROTO=Simple

%runscript
    exec "$@"
